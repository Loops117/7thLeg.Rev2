# =============================================================================
# Supabase + Vercel: use the POOLER for the app, DIRECT for migrations
# =============================================================================
#
# Where to copy strings in Supabase (current UI):
#   Project overview → next to the project URL, open the "Copy" menu → "Get Connected".
#   In the modal: tab "Direct" (connection string) → Connection method:
#       • "Transaction pooler" (port 6543) — use for Vercel / serverless DATABASE_URL
#       • "Session pooler" — IPv4-friendly alternative pooler (see Supabase hint text)
#       • "Direct connection" (port 5432) — use for DIRECT_URL / migrations
#   Type: URI. Append ?pgbouncer=true to the transaction pooler string for Prisma.
#   (Same connection options also exist under Project Settings → Database → Connection string.)
#
# Prisma + Supavisor transaction mode REQUIRES ?pgbouncer=true on the pooler URL.
# See: https://supabase.com/docs/guides/database/prisma
#
# Example TRANSACTION POOLER (fake password) — your host/region will differ:
# DATABASE_URL="postgresql://postgres.cjdrelusjfbzovahmuxu:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Example DIRECT (migrations / prisma migrate deploy from your PC):
# DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.cjdrelusjfbzovahmuxu.supabase.co:5432/postgres"
#
# Vercel: set DATABASE_URL to the pooler string; set DIRECT_URL only if you run migrations from CI.
# Local: you can use DIRECT_URL only for both while testing, or set both like production.

# Pooled (app runtime — use this as DATABASE_URL on Vercel)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct (CLI migrations — keep in .env locally; optional on Vercel)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Admin user (used by prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# NextAuth — required for sign-in. Generate: openssl rand -base64 32
AUTH_SECRET="paste-a-long-random-string-here"

# Production: https://your-project.vercel.app (no trailing slash). Optional with trustHost.
# AUTH_URL="http://localhost:3000"
#
# Public site URL (optional if AUTH_URL or VERCEL_URL covers it — used for Stripe success/cancel redirects).
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe — Checkout + webhooks (https://dashboard.stripe.com/)
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Local webhook forwarding: stripe listen --forward-to localhost:3000/api/webhooks/stripe

# Square — Web Payments (Settings → Payments → enable “Square”, then set all three vars).
# Developer: https://developer.squareup.com/apps → Credentials (Sandbox token + Application ID) → Locations (Location ID).
# SQUARE_ACCESS_TOKEN=""
# SQUARE_LOCATION_ID=""
# NEXT_PUBLIC_SQUARE_APPLICATION_ID=""
# Sandbox application ids start with sandbox- (loads sandbox card SDK automatically).
# Optional if not using a sandbox-shaped app id: SQUARE_ENV=sandbox or SQUARE_USE_SANDBOX=true
# After changing env on Vercel: redeploy. Locally: restart `npm run dev`. Test: Settings → Payments → “Test Square connection”.

# Admin toggles for Stripe vs Square live in Settings → Payments (`site_config.payment_stripe_enabled` / `payment_square_enabled`).

# Vercel Blob — REQUIRED on Vercel for any admin image upload (product/theme/global). Serverless disk is read-only.
# Dashboard: Project → Storage → Blob → create → copy "Read-Write" token → Project → Settings → Environment Variables.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Customer emails (Resend — https://resend.com). Prefer Settings → Email in admin; env vars override saved settings.
# Without a key, reset links are only logged server-side; dev may show the link on screen.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Inverts Oasis <noreply@yourdomain.com>"

# Footer “Website by 7th Leg” link (optional; https URL, no trailing slash).
# NEXT_PUBLIC_SITE_BUILDER_URL="https://example.com"

# Google Maps JavaScript API (Places) — optional; enables address autocomplete on /account.
# Create a key in Google Cloud Console, enable "Maps JavaScript API" and "Places API", restrict by HTTP referrer in production.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
